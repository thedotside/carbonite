root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
max_line_length = 100

# CSharpier owns whitespace. Meziantou's default diagnostics stay enabled; culture and
# comparison rules are warnings, hence errors through TreatWarningsAsErrors: a snapshot
# library must never depend on the machine's culture.
dotnet_diagnostic.MA0001.severity = warning
dotnet_diagnostic.MA0002.severity = warning
dotnet_diagnostic.MA0011.severity = warning
dotnet_diagnostic.MA0040.severity = warning
# Serializer and engine methods read top to bottom; keep length feedback in the IDE.
dotnet_diagnostic.MA0051.severity = suggestion

[*.{json,csproj,props,targets,slnx,yml,yaml}]
indent_style = space
indent_size = 2

[**/__snapshots__/**]
# Written by Carbonite: an editor must not rewrite a reference value.
trim_trailing_whitespace = false

[{tests,samples}/**/*.cs]
# Test code does not need the library ConfigureAwait convention.
dotnet_diagnostic.MA0004.severity = none
